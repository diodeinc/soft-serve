# vi: set ft=conf

# start soft serve
exec soft serve &
# wait for SSH server to start
ensureserverrunning SSH_PORT

# create user
soft user create user1 --key "$USER1_AUTHORIZED_KEY"

# generate jwt token
soft jwt
stdout '.*\..*\..*'
soft jwt repo
stdout '.*\..*\..*'
usoft jwt
stdout '.*\..*\..*'
usoft jwt repo
stdout '.*\..*\..*'

# jwt as http basic password
soft repo create repo
soft jwt repo
cp stdout jwtfile
envfile JWT=jwtfile
mkdir ./repo
git -c init.defaultBranch=master -C repo init
mkfile ./repo/README.md '# Project'
git -C repo add -A
git -C repo commit -m 'first'
! git -C repo push http://user1:$JWT@localhost:$HTTP_PORT/repo HEAD
git -C repo push http://admin:$JWT@localhost:$HTTP_PORT/repo HEAD

# stop the server
[windows] stopserver
[windows] ! stderr .
